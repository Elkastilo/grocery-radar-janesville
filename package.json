{
  "name": "grocery-radar-janesville",
  "version": "1.0.0",
  "description": "Crowdsourced grocery price reports for Janesville, Wisconsin.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:client": "node scripts/build-client.js",
    "build:all": "npm run build:client",
