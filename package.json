{
  "name": "grocery-radar-janesville",
  "version": "1.0.0",
  "description": "Crowdsourced grocery price reports for Janesville, Wisconsin.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:client": "node scripts/build-client.js",
    "build:all": "npm run build:client",
    "repair:owner": "node scripts/repair-owner-identity.js --apply",
    "test:intake": "node scripts/test-price-intake.js",
    "test:ai-proof": "node scripts/test-ai-proof-engine.js",
    "test:workflow-schema": "node scripts/test-workflow-schema.js",
    "test:auth": "node scripts/test-super-admin-auth.js",
    "test:operations": "node scripts/test-operations-center.js",
    "test:review-ux": "node scripts/test-review-ux.js",
    "test:public-products-null": "node scripts/test-public-product-null-safety.js",
    "test:major-intake": "node scripts/test-major-intake-pass.js",
    "test:owner-repair": "node scripts/test-owner-repair.js",
    "test:owner-startup-repair": "node scripts/test-owner-startup-repair.js",
    "test:operations-scale": "node scripts/test-operations-scale.js",
    "test:restore-drill": "node scripts/test-restore-drill.js",
    "restore:drill": "node scripts/restore-drill.js",
    "test": "npm run test:intake && npm run test:ai-proof && npm run test:workflow-schema && npm run test:auth && npm run test:review-ux && npm run test:public-products-null && npm run test:operations && npm run test:major-intake && npm run test:operations-scale && npm run test:restore-drill && npm run test:owner-repair && npm run test:owner-startup-repair",
    "setup:email": "node scripts/setup-email.js",
    "debug:email": "node scripts/debug-email.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^7.0.0"
  }
}
